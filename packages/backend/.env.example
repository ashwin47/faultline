# Server Configuration
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Database
DB_PATH=./data/faultline.db
# ENCRYPTION_KEY will be auto-generated on first run and stored in database
# Do not set this manually unless migrating data

# JWT Secret (stable across restarts to preserve user sessions)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_SECRET=

# Logging
LOG_LEVEL=info

# OpenAI Model Configuration
# OPENAI_MODEL=gpt-4.1                # Main model for agent (default: gpt-4.1)
# OPENAI_SUMMARY_MODEL=gpt-4.1-mini   # Model for summarization (default: gpt-4.1-mini)

# All API keys are managed through the Settings UI
# No need to set them here - they are stored encrypted in the database
